# "dev" or "prod" — selects which SQLite file is used under DATABASE_DIR
# (haute_tension_dev.sqlite3 / haute_tension_prod.sqlite3). The book itself is
# read off disk; the file holds the reading history, the play-throughs and the
# flagged pages, and is created on first use, tables included.
#
# DATABASE_DIR is the directory the files live in — a relative path is taken
# from the repository root. APP_ENV is what picks the file inside it.
APP_ENV=dev
DATABASE_DIR=data

# Signs the session cookie that carries a play-through id. Leave it empty in dev
# (a random key is generated at startup); set a long random value in production
# (python -c "import secrets; print(secrets.token_hex(32))") or every restart
# starts every reader on a new hero.
FLASK_SECRET_KEY=

# The general log, logs/general.log. DEBUG unless raised here: a trace one must
# first go and turn on is a trace one does not have on the day it is needed.
LOG_LEVEL=DEBUG

# Beyond that many characters a logged value is cut and says by how much.
# 0 writes every answer whole, however long.
LOG_VALUE_LIMIT=2000
