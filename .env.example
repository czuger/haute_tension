# "dev" or "prod" — selects which SQLite file is used under DATABASE_DIR
# (haute_tension_dev.sqlite3 / haute_tension_prod.sqlite3). The book itself is
# read off disk; the file holds the reading history, the play-throughs and the
# flagged pages, and is created on first use, tables included.
#
# DATABASE_DIR is the directory the files live in — a relative path is taken
# from the repository root. APP_ENV is what picks the file inside it.
APP_ENV=dev
DATABASE_DIR=data

# Signs the session cookie that carries a play-through id. Leave it empty in dev
# (a random key is generated at startup); set a long random value in production
# (openssl rand -hex 32) or every restart starts every reader on a new hero.
SESSION_SECRET_KEY=

# The sub-path the site is served under, when a proxy in front of it serves the
# site somewhere other than the root of its host: https://<host>/haute-tension/.
# The proxy strips it on the way in, so no route ever sees it; the application
# puts it back on every link, every redirect and the cookie's Path. Empty — the
# development default — is a site at the root, and nothing is prefixed.
URL_PREFIX=

# The UNIX socket the server listens on instead of its development port. Empty in
# development, where the server listens on 127.0.0.1:5001 and a browser reaches it
# directly; set on a deployed run, where the proxy connects to the socket and no
# port is published at all (/run/haute_tension/serve.sock there). A relative path
# is taken from the repository root.
LISTEN_SOCKET=

# The general log, logs/general.log. DEBUG unless raised here: a trace one must
# first go and turn on is a trace one does not have on the day it is needed.
LOG_LEVEL=DEBUG

# Beyond that many characters a logged value is cut and says by how much.
# 0 writes every answer whole, however long.
LOG_VALUE_LIMIT=2000

# Read by scripts/text_to_speech.sh only, never by the application: the ElevenLabs API key
# (https://elevenlabs.io, profile → API keys) and, optionally, the voice to read with — list the
# account's voices with `scripts/text_to_speech.sh -l`. Empty voice is the script's default.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
